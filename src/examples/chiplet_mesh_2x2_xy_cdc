// 2x2 chiplet grid, xy D2D, k=2, four dies with mixed nominal clocks (CDC on all D2D).
// Die order row-major: (0,0),(1,0),(0,1),(1,1) -> periods 2,3,3,2.
topology = chiplet_mesh;
routing_function = dim_order_chiplet_mesh;

chiplet_x = 2;
chiplet_y = 2;
chiplet_k = 2;
chiplet_connect = xy;

chiplet_die_k = {2,2,2,2};

chiplet_cdc_enable = 1;
chiplet_die_clock_period = {2,3,3,2};
chiplet_die_clock_phase = {0,0,0,0};
chiplet_d2d_latency = 2;
chiplet_cdc_sync_cycles = 2;
chiplet_cdc_credit_sync_cycles = 2;
chiplet_cdc_fifo_depth = 64;

chiplet_intra_latency = 1;

num_vcs     = 8;
vc_buf_size = 8;
wait_for_tail_credit = 1;

vc_allocator = islip;
sw_allocator = islip;
alloc_iters  = 1;

credit_delay   = 2;
routing_delay  = 0;
vc_alloc_delay = 1;
sw_alloc_delay = 1;

input_speedup     = 2;
output_speedup    = 1;
internal_speedup  = 1.0;

traffic = uniform;
packet_size = 4;

sim_type = latency;
injection_rate = 0.0008;
latency_thres = 12000.0;
